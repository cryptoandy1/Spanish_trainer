      "topics": ["tp_transporte"],
      "source": { "origin": "manual", "ingestBatch": "seed-2026-08-04", "extractor": "seed" }
    },
    {
      "id": "ph_4d3e6f7a",
      "text": "¿Dónde están las llaves?",
